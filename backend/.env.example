APP_NAME=TruthLens AI API
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use sqlite for local development; change to supabase after project setup.
DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_PATH=data/truthlens.db
MODEL_PROVIDER=traditional
TRANSFORMER_MODEL_PATH=backend/models/liar_distilbert

# Fill these in after creating a Supabase project and set DATABASE_PROVIDER=supabase.
# Never expose the service-role key in the React frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_FACT_CHECK_API_KEY=
